                {
                  "text": "Imponer reglas sin proposito",
                  "is_correct": false
                },
                {
                  "text": "Fijar la pronunciacion de cada palabra",
                  "is_correct": false
                },
                {
                  "text": "Determinar el vocabulario disponible",
                  "is_correct": false
                }
              ]
            },
            {
              "prompt": "Por que la traduccion literal suele sonar poco natural?",
