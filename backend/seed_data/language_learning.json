          "lesson_type": "test",
          "duration_minutes": 8,
          "questions": [
            {
              "prompt": "Por que cuesta pronunciar sonidos de otra lengua?",
              "options": [
                {
                  "text": "El oido tiende a asimilarlos a los de la lengua materna",
                  "is_correct": true
                },
                {
                  "text": "Los musculos no pueden producirlos",
                  "is_correct": false
                },
                {
                  "text": "Solo se aprende en la infancia",
                  "is_correct": false
                },
                {
                  "text": "Depende del alfabeto usado",
                  "is_correct": false
                }
              ]
            },
            {
              "prompt": "Que es un par minimo?",
              "options": [
                {
                  "text": "Dos palabras que se diferencian en un solo sonido",
