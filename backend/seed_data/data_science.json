                {
                  "text": "Desviacion tipica",
                  "is_correct": false
                }
              ]
            },
            {
              "prompt": "Por que la mediana resiste mejor los valores atipicos?",
              "options": [
                {
                  "text": "Depende de la posicion central, no de la magnitud",
                  "is_correct": true
                },
                {
                  "text": "Ignora la mitad de los datos extremos",
                  "is_correct": true
                },
                {
                  "text": "No se calcula sumando todos los valores",
                  "is_correct": true
