# Copia este archivo a backend/.env y ajusta los valores.
# cp .env.example .env

# Postgres debe estar accesible en localhost (fuera de Docker Compose)
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
DATABASE_URL=postgresql+psycopg://usuario:contrasena@localhost:5432/web_app_courses
EXP_TOKEN=30
REFRESH_TOKEN_DAYS=7

# Entorno (production desactiva rutas de desarrollo por defecto)
# ENVIRONMENT=development
# ENABLE_DEV_ROUTES=true

# Recuperacion de contrasena (opcional; sin esto, el enlace se registra en el log del backend)
# FRONTEND_URL=http://localhost:5173
# RESET_TOKEN_MINUTES=30
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_mailtrap_user
# SMTP_PASSWORD=your_mailtrap_password
# SMTP_FROM=Kursa <noreply@kursa.local>
