# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env

# --- PostgreSQL (servicio "db" en docker-compose) ---
POSTGRES_USER=kursa
POSTGRES_PASSWORD=kursa_dev_change_me
POSTGRES_DB=kursa

# --- Backend (usa el hostname "db" dentro de Docker; no uses localhost) ---
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB. SQLAlchemy + psycopg 3:
DATABASE_URL=postgresql+psycopg://kursa:kursa_dev_change_me@db:5432/kursa

# JWT (obligatorio; usa una cadena larga y aleatoria en producción)
SECRET_KEY=change-me-to-a-long-random-string

# Opcionales
# ALGORITHM=HS256
# EXP_TOKEN=30
