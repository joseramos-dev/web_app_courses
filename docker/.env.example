# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env

# --- PostgreSQL (servicio "db" en docker-compose) ---
POSTGRES_USER=kursa
POSTGRES_PASSWORD=kursa_dev_change_me
POSTGRES_DB=kursa

# --- Backend (usa el hostname "db" dentro de Docker; no uses localhost) ---
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB. SQLAlchemy + psycopg 3:
DATABASE_URL=postgresql+psycopg://kursa:kursa_dev_change_me@db:5432/kursa

# JWT (obligatorio; usa una cadena larga y aleatoria en producción)
SECRET_KEY=change-me-to-a-long-random-string

# Opcionales
# ALGORITHM=HS256
# EXP_TOKEN=30
# REFRESH_TOKEN_DAYS=7

# Entorno (production desactiva rutas de desarrollo por defecto)
# ENVIRONMENT=development
# ENABLE_DEV_ROUTES=true

# Orígenes CORS permitidos (separados por coma)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cabecera Host permitida (separada por comas). Por defecto "*" en desarrollo.
# ALLOWED_HOSTS=api.midominio.com

# --- Cookie de sesión (refresh token) ---
# El refresh token viaja en una cookie HttpOnly, no en localStorage.
#
# IMPORTANTE: con SameSite=lax, el frontend y la API deben estar en el MISMO
# sitio. "localhost" y "127.0.0.1" cuentan como sitios distintos: si abres el
# frontend en http://127.0.0.1:5173 mientras VITE_API_URL apunta a
# http://localhost:8000, podrás iniciar sesión pero la sesión se perderá al
# recargar, porque el navegador no adjunta la cookie. Usa el mismo nombre de
# host en ambos. Si en producción la API vive en otro dominio, hace falta
# COOKIE_SAMESITE=none junto con COOKIE_SECURE=true (que exige HTTPS).
# COOKIE_SECURE=true          # por defecto: solo si ENVIRONMENT=production
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.midominio.com

# --- Rate limiting ---
# Almacenamiento en memoria del proceso: con varios workers, cada uno lleva su
# propia cuenta. Para producción real haría falta Redis.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=200/minute

# Tamaño máximo de fichero subido y de la petición completa (bytes)
# MAX_UPLOAD_BYTES=10485760
# MAX_REQUEST_BYTES=11534336

# Frontend (URL del API vista desde el navegador del host)
# VITE_API_URL=http://localhost:8000/

# Recuperación de contraseña (backend)
# FRONTEND_URL=http://localhost:5173
# RESET_TOKEN_MINUTES=30
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_mailtrap_user
# SMTP_PASSWORD=your_mailtrap_password
# SMTP_FROM=Kursa <noreply@kursa.local>
